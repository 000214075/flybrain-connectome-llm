{
  "run_name": "flybrain-domain-v3",
  "data_dir": "data/tokenized_domain",
  "tokenizer_path": "data/tokenized/tokenizer.json",
  "out_dir": "checkpoints/flybrain-full",
  "build_pathway_from": "data/pathway_malecns.npz",
  "brain_firing_target": 0.05,
  "brain_firing_penalty": 2.0,
  "brain_drive_orthogonality": 1.0,
  "brain_participation_penalty": 0.1,
  "model": {
    "vocab_size": 16384,
    "d_model": 512,
    "n_layers": 8,
    "n_heads": 8,
    "context": 512,
    "ffn_mode": "mb",
    "mb_steps": 1,
    "mb_kc_sparsity": 0.05,
    "mb_spiking": true,
    "mb_norm": true,
    "mb_copies": 1,
    "mb_min_weight": 1.0,
    "brain_path": "data/wholebrain.npz",
    "brain_rank": 128,
    "brain_chunks": 4,
    "brain_iters": 1,
    "brain_spiking": true,
    "brain_edge_chunk": 4000000,
    "brain_impl": "index_add",
    "brain_in_layers": true,
    "brain_analog_readout": true
  },
  "lr": 0.0001,
  "min_lr_ratio": 0.2,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "warmup_steps": 30,
  "batch_size": 8,
  "grad_accum": 8,
  "max_steps": 400,
  "eval_interval": 50,
  "eval_iters": 30,
  "log_interval": 10,
  "checkpoint_interval": 50,
  "sample_interval": 100,
  "sample_prompt": "苍蝇的大脑",
  "dtype": "bf16",
  "num_workers": 2,
  "resume": "weights"
}
