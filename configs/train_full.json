{
  "run_name": "flybrain-full",
  "data_dir": "data/tokenized",
  "tokenizer_path": "data/tokenized/tokenizer.json",
  "out_dir": "checkpoints/flybrain-full",
  "build_pathway_from": "data/pathway_malecns.npz",
  "brain_firing_target": 0.05,
  "brain_firing_penalty": 2.0,
  "model": {
    "vocab_size": 16384,
    "d_model": 512,
    "n_layers": 8,
    "n_heads": 8,
    "context": 512,
    "ffn_mode": "mb",
    "mb_steps": 1,
    "mb_kc_sparsity": 0.05,
    "mb_spiking": true,
    "mb_norm": true,
    "mb_copies": 1,
    "mb_min_weight": 1.0,
    "brain_path": "data/wholebrain.npz",
    "brain_rank": 64,
    "brain_chunks": 2,
    "brain_iters": 1,
    "brain_spiking": true,
    "brain_edge_chunk": 4000000,
    "brain_impl": "index_add"
  },
  "lr": 0.0006,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "warmup_steps": 200,
  "batch_size": 16,
  "grad_accum": 4,
  "max_steps": 3000,
  "eval_interval": 150,
  "eval_iters": 40,
  "log_interval": 20,
  "checkpoint_interval": 300,
  "sample_interval": 300,
  "sample_prompt": "苍蝇的大脑",
  "dtype": "bf16",
  "num_workers": 2,
  "resume": "auto"
}
