{
  "run_name": "smoke-brain",
  "data_dir": "data/tokenized",
  "tokenizer_path": "data/tokenized/tokenizer.json",
  "out_dir": "checkpoints/smoke-brain",
  "build_pathway_from": "data/pathway_malecns.npz",
  "model": {
    "vocab_size": 16384,
    "d_model": 128,
    "n_layers": 2,
    "n_heads": 4,
    "context": 256,
    "ffn_mode": "mb",
    "mb_steps": 1,
    "mb_spiking": true,
    "brain_path": "data/wholebrain.npz",
    "brain_rank": 32,
    "brain_chunks": 2,
    "brain_iters": 2,
    "brain_spiking": true,
    "brain_impl": "csr"
  },
  "lr": 0.0006,
  "batch_size": 4,
  "grad_accum": 1,
  "max_steps": 20,
  "eval_interval": 10,
  "eval_iters": 4,
  "log_interval": 5,
  "checkpoint_interval": 10,
  "sample_interval": 10,
  "dtype": "bf16",
  "num_workers": 0,
  "resume": "none"
}
